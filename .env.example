# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# ---- Email (optional) -------------------------------------------------------
# Only needed if you use --email / --email-on-change or the watchdog.
# Microsoft 365 Graph API, client-credentials flow. The app registration needs the
# Mail.Send APPLICATION permission plus admin consent.
MS365_TENANT_ID=your-tenant-id
MS365_CLIENT_ID=your-client-id
MS365_CLIENT_SECRET=your-client-secret

# Sender. Must be a real, licensed mailbox in the tenant — a Google-only identity
# with no mailbox is rejected by Graph with a 404 "requested user is invalid".
MS365_FROM_ADDRESS=sender@example.com

# Who gets the run report (progress: videos added, quota reached).
REPORT_TO=reports@example.com
# Who gets failures and watched-video previews. Defaults to REPORT_TO when unset.
ERROR_ALERT_TO=operator@example.com

# When the scheduled jobs run, on a 24-hour clock. Written by `make change-run-time`;
# read only when installing or reinstalling the jobs, since the scheduler keeps its own
# copy of the time. WATCHDOG_AT defaults to six hours after SYNC_AT and should stay well
# clear of it: a watchdog on the sync's own schedule is silent in exactly the case it
# exists to catch.
SYNC_AT=03:00
WATCHDOG_AT=09:00

# Optional label printed in the report header, e.g. the account that owns the
# playlists. Leave unset to omit it.
ACCOUNT_LABEL=

# ---- Google / YouTube (required) --------------------------------------------
# Create an OAuth "Desktop app" client in Google Cloud, put its id/secret here,
# then run `npm run authorize` to fill GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=generated-by-npm-run-authorize
