#!/bin/sh
# Runs on every `git push`. Blocks the push if anything in `make ci` fails.
# Enabled via: git config core.hooksPath .githooks   (run once per clone)
#
# One command rather than lint-then-test, so the hook and `make ci` can never disagree
# about what "ready to push" means. ci deliberately runs everything and reports all the
# failures at once: a gate that stops at the first one is a gate people learn to skip
# with --no-verify.

set -e

echo "[pre-push] make ci — lint, tests, and the pre-push checks..."
node make.js ci

echo "[pre-push] OK."
