# Dependencies
node_modules/

# Secrets — NEVER commit (all creds live in .env now)
.env
.env.*
!.env.example

# Generated output
report.html
logs/
*.log

# Your own channel list (config/channels.example.txt is the tracked template)
config/channels.txt

# Local watched-video ledger (per machine; see README "Watched videos")
state/

# macOS Finder metadata — turns up in any directory opened in the GUI
.DS_Store

# Local archives and downloads. Nothing in this project ships as a zip, so anything
# matching here is something that wandered into the working tree, not a deliverable.
*.zip

# Machine-to-machine handover notes. Transferred by hand alongside .env and state/,
# because they name hosts, schedules and which machine is currently live — operational
# detail about a deployment, not source.
docs/turnover/

# Mailbox between two Claude sessions sharing this tree (see .agent-pipe/README.md).
# Working notes, not history: whichever session is not holding the pen leaves proposals here
# instead of editing the tree. Ignored is not the same as gone -- these are plaintext files
# in the working directory, so nothing secret goes in one.
.agent-pipe/

# Agent mailbox, created on demand by the agent-pipe skill when two Claude sessions share
# this working tree. CLAUDE.md already describes it as gitignored; this makes that true.
# It holds working notes and proposed diffs — conversation, not history — and in a public
# repo that is exactly the kind of thing that should never be pushed by accident.
.agent-pipe/
